# Copy to .env and fill in. Leave a block empty to use mock data for that service.
# Never commit .env.

# --- Moloni (free developer account + demo company) ---
MOLONI_DEVELOPER_ID=
MOLONI_CLIENT_SECRET=
MOLONI_USERNAME=
MOLONI_PASSWORD=
# Optional: company_id of the demo company (otherwise the first company is used)
MOLONI_COMPANY_ID=

# --- WhatsApp Cloud API (Meta free test number) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Every message goes to this number (must be in the test number's allowlist), format 3519XXXXXXXX
WA_TEST_RECIPIENT=
# Optional approved template name. Empty = free text (works only within 24 h after the recipient wrote to the test number)
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=pt_PT

# --- Stripe TEST mode (recommended: no company needed) ---
# Dashboard -> Developers -> API keys, test mode. Must start with sk_test_
STRIPE_SECRET_KEY=

# --- easypay sandbox (asks for a company NIF at signup; optional) ---
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=
# MB WAY sandbox number: 911234567 = authorises, 917654321 = fails
EASYPAY_MBWAY_TEST_PHONE=911234567

# --- App ---
PORT=3000
BUSINESS_NAME=Distribuidora Exemplo
# Commercial late-payment interest rate, 2nd half of 2026 (DL 62/2013)
LATE_INTEREST_RATE=10.40
