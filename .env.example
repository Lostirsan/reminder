# Copy to .env.local for `npm run dev`. On Cloudflare, set the same names as Worker secrets/vars.

# Public URL of the app, no trailing slash (used in pay links, webhooks, OAuth redirects)
APP_URL=http://localhost:3000

# Supabase project (Frankfurt). Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64: encrypts Moloni tokens in the database.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Shared secret for the 15-minute pg_cron call to /api/cron/tick (any long random string)
CRON_SECRET=

# --- Payments: Stripe (test keys work without a company) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Without Stripe, 1 shows a "simulate payment" button on pay pages (demo only, never in production)
ALLOW_DEMO_PAYMENTS=1

# --- Bank (free payment detection): Enable Banking, enablebanking.com → Control Panel → Applications ---
# Production app; Redirect URL <APP_URL>/api/integrations/enablebanking/callback. Free "restricted" mode
# only reads accounts first linked in the Control Panel ("Link accounts"). Key: the .pem downloaded
# when the app was created (newlines may be written as \n).
ENABLEBANKING_APP_ID=
ENABLEBANKING_PRIVATE_KEY=

# --- WhatsApp: Twilio (preferred while Meta is locked) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# New "Try out WhatsApp" trials only send templates: HX... from Console → Send a WhatsApp message
TWILIO_CONTENT_SID=
# Optional, e.g. {"1":"{due}","2":"{invoice}"}; placeholders: {name} {invoice} {amount} {due} {link} {sender}
TWILIO_CONTENT_VARIABLES=
# --- or WhatsApp Cloud API (Meta), once the business is verified ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=pt_PT

# --- Email: Resend ---
RESEND_API_KEY=
EMAIL_FROM=Pago a Tempo <onboarding@resend.dev>

# --- Test safety: while testing, send EVERY WhatsApp/email to these instead of real customers ---
WHATSAPP_TEST_RECIPIENT=
EMAIL_TEST_RECIPIENT=

# --- Moloni developer app (moloni.pt/dev). Redirect URL: <APP_URL>/api/integrations/moloni/callback ---
MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
